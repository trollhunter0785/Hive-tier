rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isTester() {
      return signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid));
    }
    function validHead(d) {
      return !('headData' in d) || (d.headData is string && d.headData.size() < 2000
        && d.headData.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$'));
    }
    function validYoutube(d) {
      return !('youtube' in d) || (d.youtube is string && d.youtube.size() <= 200);
    }

    // You create these by hand in the console: roles/{uid} with field role = "tester"
    match /roles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Reserves a username so two people cannot take the same one
    match /names/{n} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.ign.lower() == n;
      allow update, delete: if false;
    }

    // Public profile (shown on the leaderboard and player pages)
    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ign','region','youtube','headData','createdAt'])
        && request.resource.data.keys().hasAll(['ign','region','createdAt'])
        && request.resource.data.ign is string
        && request.resource.data.ign.matches('^[A-Za-z0-9_]{3,16}$')
        && request.resource.data.region in ['','NA','EU','AS','SA','OC','AF']
        && validYoutube(request.resource.data)
        && validHead(request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ign','region','youtube','headData','createdAt'])
        && request.resource.data.ign == resource.data.ign
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.region in ['','NA','EU','AS','SA','OC','AF']
        && validYoutube(request.resource.data)
        && validHead(request.resource.data);
    }

    // Private details: only the owner and testers can read them
    match /private/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTester());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['discord','serverLink','religion'])
        && request.resource.data.discord is string && request.resource.data.discord.size() <= 40
        && request.resource.data.serverLink is string && request.resource.data.serverLink.size() <= 200
        && request.resource.data.religion is string && request.resource.data.religion.size() <= 30;
    }

    // Tiers: only testers can write
    match /players/{uid} {
      allow read: if true;
      allow write: if isTester();
    }

    // Full skin (base64 PNG), loaded only on a player's page
    match /skins/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data','updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 50000
        && request.resource.data.data.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$');
    }

    // Only the two players (and testers) can see a challenge
    match /challenges/{id} {
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid
        || resource.data.toUid == request.auth.uid || isTester());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fromUid','toUid','fromName','toName','modes','time','about','religion','fromDiscord','toDiscord','status','awaiting','results','createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.awaiting == request.resource.data.toUid
        && request.resource.data.modes is list
        && request.resource.data.modes.size() >= 1 && request.resource.data.modes.size() <= 3
        && request.resource.data.modes.hasOnly(['boxing','midfight','sky'])
        && request.resource.data.time is number
        && request.resource.data.about.size() <= 300
        && request.resource.data.religion.size() <= 30
        && request.resource.data.fromDiscord.size() <= 40
        && exists(/databases/$(database)/documents/users/$(request.resource.data.toUid));
      allow update: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','awaiting','time','toDiscord','fromDiscord','results','winner']);
      // testers can settle disputed matches
      allow update: if isTester()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','winner']);
    }
  }
}
